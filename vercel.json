{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.perfectmockup.com" }],
      "destination": "https://perfectmockup.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "boostugc.com" }],
      "destination": "https://perfectmockup.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.boostugc.com" }],
      "destination": "https://perfectmockup.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
