const chipSizeClasses = {
  xs: 'px-2.5 py-1.5 text-[11px]',
  sm: 'px-3 py-2 text-xs',
  md: 'px-4 py-2.5 text-sm'
};

const chipBaseClass = 'rounded-xl border font-medium tracking-tight transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400/50 focus-visible:ring-offset-0';
const chipActiveClass = 'border-indigo-300/90 bg-gradient-to-r from-indigo-600/30 via-indigo-500/20 to-purple-500/20 text-white shadow-[0_10px_40px_rgba(88,80,220,0.35)]';
const chipInactiveClass = 'border-transparent bg-white/5 text-gray-300 hover:bg-white/10';

const chipClasses = (isActive: boolean, size: keyof typeof chipSizeClasses = 'sm', extra = '') =>
  [chipBaseClass, chipSizeClasses[size], isActive ? chipActiveClass : chipInactiveClass, extra].join(' ').trim();

interface FieldLabelProps {
  label: string;
  tooltip?: string;
  subcopy?: string;
}

const FieldLabel: React.FC<FieldLabelProps> = ({ label, tooltip, subcopy }) => (
  <div className="space-y-1">
    <div className="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.25em] text-gray-300">
      <span>{label}</span>
      {tooltip && (
        <Tooltip>
          <TooltipTrigger asChild>
            <button
              type="button"
              className="text-gray-400 hover:text-indigo-200 transition"
              onClick={(event) => event.preventDefault()}
            >
              <span className="sr-only">{`More info about ${label}`}</span>
              <Info className="w-3.5 h-3.5" />
            </button>
          </TooltipTrigger>
          <TooltipContent side="top" className="max-w-xs rounded-xl border border-gray-700 bg-gray-900 px-3 py-2 text-sm text-gray-100 shadow-2xl">
            {tooltip}
          </TooltipContent>
        </Tooltip>
      )}
    </div>
    {subcopy && <p className="text-xs text-gray-500">{subcopy}</p>}
  </div>
);

interface AccordionSectionProps {
