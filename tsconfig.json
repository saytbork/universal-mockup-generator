{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "skipLibCheck": true
    ,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src",
    "api",
    "server",
    "App.tsx"
  ]
  ,
  "exclude": [
    "**/__tests__",
    "src/**/__tests__",
    "**/*.test.ts",
    "src/**/*.test.ts"
  ]
}
