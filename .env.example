## Client (Vite)
# Enable/disable the in-app support widget (frontend)
VITE_SUPPORT_WIDGET_ENABLED=false

# Optional: show a contact email in the widget
VITE_SUPPORT_EMAIL=

# Enable/disable OpenAI mode for the in-app widget (frontend)
VITE_SUPPORT_AI_ENABLED=false

## Serverless (Vercel Functions)
# Session/auth hardening
SESSION_SECRET=
MAGIC_TOKEN_SECRET=
EMAIL_VERIFICATION_SECRET=
GUEST_TRIAL_SECRET=
# Persistent rate limits / credit accounting (configure in production)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Comma-separated admin emails (no defaults in code)
ADMIN_EMAILS=
UNLIMITED_CREDITS_EMAILS=

# SMTP sender (for magic link emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAGIC_EMAIL_USER=
MAGIC_EMAIL_PASS=
# Either set SMTP_FROM, or set FROM_NAME + FROM_EMAIL
SMTP_FROM=Perfect Mockup <no-reply@yourdomain.com>
FROM_NAME=Perfect Mockup
FROM_EMAIL=no-reply@yourdomain.com
# Optional explicit sender override used by verification email service
EMAIL_FROM=

# Enable/disable the OpenAI-backed support endpoint
SUPPORT_AI_ENABLED=false

# AI provider keys (server-side only; never prefix these with VITE_)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Comma-separated Google image model IDs allowed by /api/generate
ALLOWED_GOOGLE_IMAGE_MODELS=gemini-2.5-flash-image,gemini-3.1-flash-image

# Optional build-time model selector for controlled A/B previews. Leave empty to use 2.5 default.
VITE_GOOGLE_IMAGE_MODEL=
# Anonymous free-generation abuse controls
ANON_FREE_GENERATION_CAP=2
ANON_FREE_DEVICE_DAILY_CAP=2
ANON_FREE_IP_DAILY_CAP=8

# Owner/tester redemption code. Server-side only. Never use VITE_TESTER_CODE.
TESTER_UPGRADE_CODE=
TESTER_UPGRADE_BONUS_CREDITS=99999

# Optional invitation/trial coupon codes. Server-side only.
INVITATION_CODE=
INVITATION_BONUS_CREDITS=10
TRIAL_COUPON_CODE=
TRIAL_COUPON_BONUS_CREDITS=20
TRIAL_COUPON_MAX_REDEMPTIONS=3

# Optional generation controls
UNLIMITED_CREDITS=false
UPSCALE_PROVIDER=

# Optional: model + rate limit
OPENAI_SUPPORT_MODEL=gpt-4o-mini
SUPPORT_AI_RL_MAX=20

# Temporarily disable gallery backend (read returns empty, writes disabled)
GALLERY_DISABLED=false

# Studio prompt engine selector (safe rollout):
# false -> legacy Studio engine (default)
# true  -> ProductStudioV2 engine
# IMPORTANT: Frontend flag must use VITE_ prefix in Vite projects.
VITE_USE_STUDIO_V2=false

# Firebase Service Account (Server-side only)
# Get this from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON as a single line in Vercel Environment Variables
# ⚠️ NEVER commit the actual credentials to the repository
# Only configure in Vercel Dashboard → Settings → Environment Variables
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Stripe server-side plan mapping
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=

# Optional extra trusted image hosts for gallery proxy, comma-separated.
# storage.googleapis.com and firebasestorage.googleapis.com are already allowed.
GALLERY_PROXY_ALLOWED_HOSTS=
