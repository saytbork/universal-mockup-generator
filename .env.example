## Client (Vite)
# Enable/disable the in-app support widget (frontend)
VITE_SUPPORT_WIDGET_ENABLED=false

# Optional: show a contact email in the widget
VITE_SUPPORT_EMAIL=

# Enable/disable OpenAI mode for the in-app widget (frontend)
VITE_SUPPORT_AI_ENABLED=false

## Serverless (Vercel Functions)
# Enable/disable the OpenAI-backed support endpoint
SUPPORT_AI_ENABLED=false

# OpenAI key (set in Vercel / never commit real values)
OPENAI_API_KEY=

# Optional: model + rate limit
OPENAI_SUPPORT_MODEL=gpt-4o-mini
SUPPORT_AI_RL_MAX=20

# Temporarily disable gallery backend (read returns empty, writes disabled)
GALLERY_DISABLED=false
